<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Every permission below is requested at runtime only when the owner turns on the matching feature in
         Setup; see docs/PERMISSIONS.md. Denying one disables only that feature. -->

    <!-- Link (Bluetooth LE peripheral). Android 12+ runtime permissions; legacy ones are normal permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Keeps the link alive while the phone is in a bag; shows the "gateway active" notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional "start after the phone restarts" setting (off by default). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- SIM cards and call state. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Messages. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Calls: place, answer/end, recent calls; also carrier (USSD) codes. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Full call control (optional): as the default phone app, show the incoming-call screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Optional contact sharing (off by default). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <application>
        <activity
            android:name=".gateway.GatewayActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".gateway.GatewayService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Full call control (optional, "make Pol the phone app"). Android requires a default phone app to
             handle DIAL and tel: links and to provide an in-call service. The dialer only pre-fills the number;
             nothing is dialled without a tap. The in-call service is bound only by Telecom (BIND_INCALL_SERVICE). -->
        <activity
            android:name=".gateway.telecom.DialActivity"
            android:exported="true"
            android:label="@string/gw_dialer_label">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <activity
            android:name=".gateway.telecom.PhoneCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <service
            android:name=".gateway.telecom.PolInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <receiver android:name=".gateway.telecom.CallActionReceiver" android:exported="false" />

        <!-- Shizuku hands its Binder to the app through this provider. Exported, but guarded by a permission only
             the system and the shell user hold, so other apps cannot reach it. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Not exported: BOOT_COMPLETED is sent by the system, which bypasses the export check. -->
        <receiver android:name=".gateway.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
